{
    "manifest_version": 3,
    "name": "本番まもる君",
    "version": "1.0.1",
    "permissions": ["activeTab", "scripting", "storage"],
    "host_permissions": [
        "*://*/*"
    ],
    "action": {
        "default_popup": "popup/main.html",
        "default_icon": {
            "128": "icon_128.png"
        }
    },
    "web_accessible_resources": [
        {
            "resources": ["shared/enviroments.js"],
            "matches": ["<all_urls>"]
        }
    ],
    "background": {
        "service_worker": "background.js"
    }
}
